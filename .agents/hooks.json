{
  "firstmate": {
    "SessionStart": [
      {
        "type": "command",
        "command": "sh -c \"[ -x ./bin/session-open-agy.sh ] && exec ./bin/session-open-agy.sh || exec ../bin/session-open-agy.sh\" || cd .",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|bash|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c \"[ -x ./bin/supervision-pretool-check.sh ] && exec ./bin/supervision-pretool-check.sh --agy || exec ../bin/supervision-pretool-check.sh --agy\" || cd .",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh -c \"[ -x ./bin/working-directory-pretool-check.sh ] && exec ./bin/working-directory-pretool-check.sh --agy || exec ../bin/working-directory-pretool-check.sh --agy\" || cd .",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c \"[ -x ./bin/subagent-pretool-check.sh ] && exec ./bin/subagent-pretool-check.sh --agy || exec ../bin/subagent-pretool-check.sh --agy\" || cd .",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh -c \"[ -x ./bin/turn-end-guard-agy.sh ] && exec ./bin/turn-end-guard-agy.sh || exec ../bin/turn-end-guard-agy.sh\" || cd .",
        "timeout": 28800
      }
    ]
  }
}
